<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#331E88E5" />
            <stroke
                android:width="2dp"
                android:color="@color/tv_neon_cyan" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#551E88E5" />
            <stroke
                android:width="2dp"
                android:color="@color/tv_neon_cyan" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A1E88E5" />
            <stroke
                android:width="1dp"
                android:color="@color/tv_border_neon" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
