<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.LIBANON4KPRO" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/tv_bg_dark</item>
        <item name="android:navigationBarColor">@color/tv_bg_dark</item>
        <item name="android:windowBackground">@color/tv_bg_dark</item>
        <item name="android:colorBackground">@color/tv_bg_dark</item>
        <item name="colorPrimary">@color/tv_neon_blue</item>
        <item name="colorPrimaryDark">@color/tv_accent</item>
        <item name="colorAccent">@color/tv_neon_cyan</item>
        <item name="android:textColorPrimary">@color/tv_text_primary</item>
        <item name="android:textColorSecondary">@color/tv_text_secondary</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="TVCardTitle" parent="Widget.MaterialComponents.TextView">
        <item name="android:textColor">@color/tv_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="TVActionButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/tv_neon_cyan</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:background">@drawable/bg_top_action_button</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
    </style>
</resources>
