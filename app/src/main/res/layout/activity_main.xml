<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg_dark">

    <!-- ===== SCROLLABLE MAIN CONTENT ===== -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomInfoBar"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <!-- ===== HEADER: Logo + Title + Status ===== -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="20dp"
                android:paddingBottom="16dp">

                <!-- Logo circle -->
                <FrameLayout
                    android:id="@+id/logoCircle"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_logo_circle"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="▶"
                        android:textColor="@color/white"
                        android:textSize="28sp" />
                </FrameLayout>

                <!-- Title block -->
                <LinearLayout
                    android:id="@+id/titleBlock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/logoCircle"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LIBANON"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="26sp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.12" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4K IPTV PRO"
                        android:textColor="@color/tv_neon_cyan"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.18" />

                    <!-- Neon accent line -->
                    <View
                        android:layout_width="60dp"
                        android:layout_height="2dp"
                        android:background="@color/tv_neon_cyan"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Status card -->
                <LinearLayout
                    android:id="@+id/statusCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_status_card"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true">

                    <!-- Connected row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_status_dot" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CONNECTED"
                            android:textColor="@color/tv_status_connected"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.1"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Server: Active"
                        android:textColor="@color/tv_text_secondary"
                        android:textSize="10sp"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Expires: —"
                        android:textColor="@color/tv_text_secondary"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Horizontal neon divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/tv_divider"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp" />

            <!-- ===== TOP ACTION BUTTONS ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnAddPlaylist"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="＋  Add Playlist"
                    android:textColor="@color/tv_neon_cyan"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/bg_top_action_button"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />

                <Button
                    android:id="@+id/btnFavorites"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="♥  Favorites"
                    android:textColor="@color/tv_neon_cyan"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/bg_top_action_button"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />

                <Button
                    android:id="@+id/btnSettings"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="⚙  Settings"
                    android:textColor="@color/tv_neon_cyan"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/bg_top_action_button"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />
            </LinearLayout>

            <!-- ===== SECTION LABEL ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CATEGORIES"
                android:textColor="@color/tv_neon_cyan"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.2"
                android:layout_marginStart="24dp"
                android:layout_marginBottom="12dp" />

            <!-- ===== 4 MAIN FEATURE CARDS (2×2 grid) ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Live TV card -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_main_card"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:clickable="true">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📺"
                                android:textSize="30sp"
                                android:layout_gravity="center" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Live TV"
                                android:textColor="@color/tv_text_primary"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginTop="6dp" />
                        </LinearLayout>

                        <!-- Left neon accent -->
                        <View
                            android:layout_width="3dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center_vertical|start"
                            android:background="@color/tv_neon_blue"
                            android:layout_marginStart="0dp" />
                    </FrameLayout>

                    <!-- Movies card -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_main_card"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:clickable="true">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🎬"
                                android:textSize="30sp"
                                android:layout_gravity="center" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Movies"
                                android:textColor="@color/tv_text_primary"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginTop="6dp" />
                        </LinearLayout>

                        <View
                            android:layout_width="3dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center_vertical|start"
                            android:background="@color/tv_neon_purple" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <!-- TV Series card -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_main_card"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:clickable="true">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📽"
                                android:textSize="30sp"
                                android:layout_gravity="center" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TV Series"
                                android:textColor="@color/tv_text_primary"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginTop="6dp" />
                        </LinearLayout>

                        <View
                            android:layout_width="3dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center_vertical|start"
                            android:background="@color/tv_neon_green" />
                    </FrameLayout>

                    <!-- Catch Up card -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_main_card"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:clickable="true">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⏮"
                                android:textSize="30sp"
                                android:layout_gravity="center" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Catch Up"
                                android:textColor="@color/tv_text_primary"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginTop="6dp" />
                        </LinearLayout>

                        <View
                            android:layout_width="3dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center_vertical|start"
                            android:background="@color/tv_neon_cyan" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== CHANNEL LIST SECTION ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHANNELS"
                android:textColor="@color/tv_neon_cyan"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.2"
                android:layout_marginStart="24dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />

            <!-- Progress + Empty state -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="@color/tv_neon_cyan"
                android:visibility="gone"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginStart="24dp" />

            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No channels yet — add a playlist above"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <!-- Channel RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerChannels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_channel" />

        </LinearLayout>
    </ScrollView>

    <!-- ===== BOTTOM INFO BAR ===== -->
    <LinearLayout
        android:id="@+id/bottomInfoBar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_bottom_info_bar"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome"
            android:textColor="@color/tv_text_secondary"
            android:textSize="10sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="14dp"
            android:background="@color/tv_divider"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Ready"
            android:textColor="@color/tv_status_connected"
            android:textSize="10sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIBANON4KPRO"
            android:textColor="@color/tv_neon_cyan"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1" />
    </LinearLayout>

</RelativeLayout>

